{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satit-glory-league",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "satit-glory-league",
      "database_id": "3a9b2be0-6a07-4771-b663-ca38c4c409ce",
      "migrations_dir": "migrations"
    }
  ]
}
